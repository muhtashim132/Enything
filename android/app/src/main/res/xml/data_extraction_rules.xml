<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ (API 31+) Data Extraction Rules
   Defines granular rules for Google Cloud Backup vs Direct Device-to-Device (D2D) migration.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive cryptographic keys and session tokens from Cloud Backup to prevent session hijacking -->
        <exclude path="shared_prefs/FlutterSecureStorage.xml" domain="sharedpref" />
        <exclude path="app_flutter_secure_storage" domain="database" />
        
        <!-- Exclude device-specific FCM push tokens and background service isolate states -->
        <exclude path="shared_prefs/com.google.firebase.messaging.xml" domain="sharedpref" />
        <exclude path="shared_prefs/flutter_background_service.xml" domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <!-- Seamless Onboarding: Allow user preferences, theme, and local cache to transfer to the new device -->
        <!-- Exclude hardware-bound push tokens so the new device fetches a fresh FCM token -->
        <exclude path="shared_prefs/com.google.firebase.messaging.xml" domain="sharedpref" />
        <exclude path="shared_prefs/flutter_background_service.xml" domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
