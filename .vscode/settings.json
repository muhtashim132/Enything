{
    "java.jdt.ls.java.home": "/opt/homebrew/opt/openjdk@21",
    "rubyLsp.rubyVersionManager": { "identifier": "none" },
    "java.configuration.updateBuildConfiguration": "interactive",
    "python.terminal.useEnvFile": true,
    "deno.enable": true,
    "deno.enablePaths": ["supabase/functions"],
    "deno.unstable": true,
    "python.analysis.extraPaths": [
        "/Users/muhtaashimnazki/Library/Python/3.9/lib/python/site-packages"
    ],
    "python.autoComplete.extraPaths": [
        "/Users/muhtaashimnazki/Library/Python/3.9/lib/python/site-packages"
    ],
    "editor.formatOnSaveTimeout": 1000,
    "editor.codeActionsOnSaveTimeout": 1000,
    "files.autoSave": "onFocusChange",
    "files.hotExit": "off",
    "[dart]": {
        "editor.formatOnSave": true,
        "editor.formatOnSaveTimeout": 1000,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        }
    },
    "dart.vmAdditionalArgs": [
